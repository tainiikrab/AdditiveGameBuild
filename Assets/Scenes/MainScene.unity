        \u0437\u0430\u043A\u0430\u0437\u044B, \u043F\u0438\u0441\u044C\u043C\u0430
        \u043E\u0442 \u043D\u043E\u0432\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445,
        \u0430 \u0442\u0430\u043A\u0436\u0435 \u0437\u0434\u0435\u0441\u044C \u0431\u0443\u0434\u0435\u0442
        \u0445\u0440\u0430\u043D\u0438\u0442\u044C\u0441\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
        \n\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0445
        \u0438 \u043E\u0442\u043A\u043B\u043E\u043D\u0435\u043D\u043D\u044B\u0445
        \u0437\u0430\u043A\u0430\u0437\u0430\u0445."
