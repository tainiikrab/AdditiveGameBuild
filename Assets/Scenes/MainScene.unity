    - target: {fileID: 2785338035271979768, guid: 9d61fead75edd5545ade441171dc2cda, type: 3}
      propertyPath: m_text
      value: "\u0412\u044B\u0448\u0435 \u043D\u043E\u0441! \u0421\u043C\u043E\u0442\u0440\u0438,
        \u044D\u0442\u043E - \u0442\u0432\u043E\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0435
        \u0440\u0430\u0431\u043E\u0447\u0435\u0435 \u043C\u0435\u0441\u0442\u043E.
        \u041F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0448\u044C \u0437\u0430\u043A\u0430\u0437\u044B,
        \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0448\u044C
        \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B, \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0448\u044C...\u0442\u0430\u043A,
        \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435 \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443."
