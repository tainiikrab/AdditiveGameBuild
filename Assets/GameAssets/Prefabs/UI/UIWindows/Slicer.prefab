        \u0442\u043E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043D\u0443\u0436\u043D\u043E
        \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0438\u0436\u0435 - \u0447\u0442\u043E\u0431\u044B
