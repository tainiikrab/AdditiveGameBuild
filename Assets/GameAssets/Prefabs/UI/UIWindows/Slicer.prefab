      propertyPath: m_text
      value: "\u0415\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u0441\u0443\u043F\u0435\u0440
        \u0434\u0435\u0442\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
